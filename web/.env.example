# Public origin seen by users and agents. Any domain/HTTPS port is supported.
WEB_PUBLIC_URL=https://linkedin.example.com
# Initial admin credentials: used only when the user database is empty.
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=replace-with-a-unique-random-password
# Docker host port; internal container port remains 3000.
WEB_BIND_ADDRESS=127.0.0.1
WEB_EXTERNAL_PORT=3081
# Maximum active per-user browser runtimes. Cookies remain after closing one.
WEB_MAX_BROWSERS=8
# For a local launch without Docker, use WEB_PUBLIC_URL=http://localhost:3000.
# WEB_HOST=127.0.0.1
# WEB_PORT=3000
# WEB_DATA_DIR=.data
# LINKEDIN_BROWSER_CHANNEL=chrome
# LINKEDIN_HEADLESS=false
