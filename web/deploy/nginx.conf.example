# Add to your existing Nginx configuration; replace domain/certificate paths.
# DNS must point to your server. TLS certificates are managed by your server.
server {
    listen 443 ssl;
    server_name linkedin.example.com;
    ssl_certificate /etc/letsencrypt/live/linkedin.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/linkedin.example.com/privkey.pem;

    client_max_body_size 64k;
    location / {
        proxy_pass http://127.0.0.1:3081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
server {
    listen 80;
    server_name linkedin.example.com;
    return 301 https://$host$request_uri;
}
