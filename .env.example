# visible=true is recommended: LinkedIn may require interactive login/checks.
LINKEDIN_HEADLESS=false
LINKEDIN_LOCALE=en-US
LINKEDIN_DATA_DIR=.data
LINKEDIN_PROFILE_DIR=.data/browser-profile
LINKEDIN_ACTION_MODE=review
LINKEDIN_DEFAULT_TIMEOUT_MS=15000
LINKEDIN_NAVIGATION_TIMEOUT_MS=45000
LINKEDIN_BROWSER_LAUNCH_TIMEOUT_MS=20000
# Long-lived browser worker. MCP and CLI start it automatically and leave it running.
LINKEDIN_WORKER_HOST=127.0.0.1
LINKEDIN_WORKER_PORT=17381
LINKEDIN_WORKER_AUTOSTART=true
